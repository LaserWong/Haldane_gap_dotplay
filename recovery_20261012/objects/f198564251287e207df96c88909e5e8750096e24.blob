def need(value,label):
    if not value: raise ValueError(label)
def digest(path):
    h=hashlib.sha256()
    with path.open('rb') as f:
        for block in iter(lambda:f.read(1048576),b''):h.update(block)
    return h.hexdigest()
def pairs(items):
    result={}
    for k,v in items:
        need(k not in result,'Duplicate JSON key: '+k);result[k]=v
    return result
def decode(raw):return json.loads(raw,object_pairs_hook=pairs)

def verify(root,system=False):
    root=Path(root).resolve();checked={};checks=[];maps={};external={};aliases=[]
    alias_index={(x['manifest_path'],x['logical_member']):x for x in SOURCE_ALIASES}
    def check(v,label):need(v,label);checks.append(label)
    def path(name,base=''):
        name=str(name)
        if name.startswith(ORIGINAL):name=name[len(ORIGINAL):];base=''
        need(not Path(name).is_absolute(),'Unexpected absolute reference '+name)
        if name.startswith(R):base=''
        p=(root/base/name).resolve();need(p.is_relative_to(root),'Reference escapes evidence root '+name)
        return p
    def bind(name,expected,size=None,base=''):
        p=path(name,base);k=str(p.relative_to(root));h=digest(p)
        check(h==expected,'SHA256 '+k);check(size is None or p.stat().st_size==size,'Bytes '+k)
        if k in checked:check(checked[k]['sha256']==h,'Stable repeated read '+k)
        checked[k]={'sha256':h,'bytes':p.stat().st_size};return h
    def read(name):
        p=path(name);need(str(p.relative_to(root)) in checked,'Unpinned metadata read '+name)
        return decode(p.read_text())
    def member(context,name,v,base=''):
        h=v.get('sha256') if isinstance(v,dict) else v;size=v.get('bytes') if isinstance(v,dict) else None
        check(isinstance(h,str) and re.fullmatch('[0-9a-f]{64}',h) is not None,'Hash schema '+context)
        alias=alias_index.get((context,name))
        if alias:
            check(alias['expected_sha256']==h,'Alias expected hash '+context)
            if alias not in aliases:aliases.append(alias)
            name=alias['resolved_path'];base=''
        if name.startswith('/') and not name.startswith(ORIGINAL):
            check(name.startswith(('/usr/bin/','/usr/libexec/','/opt/codex/')),'Declared external tool namespace')
            external[name]={'sha256':h,'status':'EXTERNAL_PIN_ONLY_NOT_BUNDLED'}
            if system:
                check(digest(Path(name))==h,'External tool '+name);external[name]['status']='HASHED_NOT_EXECUTED'
            return
        bind(name,h,size,base)
    def mapping(name,base):
        p=path(name);need(name in checked,'Manifest not pinned '+name)
        if p.suffix=='.json':
            x=decode(p.read_text());m=x.get('files',x)
        else:
            m={}
            for line in p.read_text().splitlines():
                if not line.strip():continue
                h,n=line.split(None,1);n=n.strip().lstrip('*');check(n not in m,'Unique member '+name+'/'+n);m[n]=h
        check(isinstance(m,dict),'Manifest dictionary '+name)
        for n,v in m.items():
            effective=base
            if n.startswith('bilayer_') and '/' in n:effective=R
            member(name,n,v,effective)
        maps[name]=len(m);return m
    # Frozen predecessor is independently anchored, never generated from current state.
    for n,h in BASELINE_PINS.items():bind(n,h)
    prior=read(R+'overview_stage37/documentary_review/stage37_hash_check_receipt.json')
    check(prior['status']=='PASS_STAGE37_DOCUMENTARY_ONLY' and len(prior['checked_files'])==1282,'Frozen Stage37 documentary baseline')
    for n,v in prior['checked_files'].items():member(R+'overview_stage37/documentary_review/stage37_hash_check_receipt.json',n,v)
    mapping(R+'overview_stage37/MANIFEST_SHA256.json',R+'overview_stage37/')
    mapping(R+'overview_stage37/EXTERNAL_TOOL_PINS.json',R+'overview_stage37/')
    frozen=read(R+'overview_stage37/FROZEN_STATUS.json')
    check(frozen['root_final_review_approved'] and frozen['new_positive_gap_rows']==0,'Root-approved Stage37 baseline; no gap promotion')
    # New snapshot inventory is literal and pinned; it is never rediscovered by hash.
    for n,v in SNAPSHOT_PINS.items():member('Stage38 selected file inventory',n,v)
    for desc in MAPS:mapping(desc['path'],desc['base'])
    for directory in EXACT_DIRECTORIES:
        expected={n for n in SNAPSHOT_PINS if n.startswith(directory+'/')}
        actual={str(p.relative_to(root)) for p in path(directory).rglob('*') if p.is_file()}
        check(actual==expected,'Exact selected namespace '+directory)
    for directory,count in [(H+'full75076_native_receipt',27),(H+'assembly75396_failure_receipt',15),(H+'assembly75572_failure_receipt',18)]:
        name=R+directory+'/MANIFEST_SHA256.json';packet=read(name)
        check(packet['path_base']==R.rstrip('/'),'Packet declared base '+directory)
        mapping(name,R);check(len(packet['files'])==count,'Packet cardinality '+directory)
    n=R+H+'full75076_native_receipt/';s=n+'state/'
    ledger=read(n+'NATIVE_TERMINAL_LEDGER.json');fields=read(s+'FULL_FIELDS.json')
    science=read(R+H+'full75076_scientific_receipt_review/ACCEPTANCE.json');resource=read(R+H+'full75076_resource_review/VERDICT.json')
    check(ledger['state']=='FULL_PAIR_OUTPUTS_ACCEPTED_ASSEMBLY_NOT_RUN_REVIEW_PENDING','Preserve native terminal raw status')
    check(fields['status']=='FULL_PHYSICAL_COMPARISON_PASS' and fields['N']==64,'Complete N64 field status')
    check(fields['origin_support_counts']=={'4':39711,'6':7028847} and fields['checkpoint_count']==440,'Native full support coverage')
    check(fields['complete_streams'] and fields['all_chunk_vectors_match'] and fields['all_controls_match'],'Native complete agreement flags')
    check(len(fields['signed_unscaled_fields'])==8 and len(fields['signed_unscaled_controls'])==6,'Eight signed fields and six controls')
    check(fields['coefficient_denominator']=='8192000000000000' and fields['denominator_power']==2,'Unchanged denominator convention')
    check(fields['no_cached_third_moment_assembled'] and fields['no_gap_claim'],'Native fields are not assembled moment or gap')
    check(science['status']=='ACCEPT_RECORDED_COMPLETE_PHYSICAL_FIELDS_PENDING_SEPARATE_RESOURCE_REVIEW','Historical science label retained')
    check(resource['passed'] and resource['verdict']=='PASS_DOCUMENTARY_NATIVE_PAIR_WITH_COORDINATOR_TERMINAL_CPU_UNMEASURED','Separate resource review resolves acceptance requirement')
    check(science['matching_chunks']==440 and science['matching_signed_fields']==8 and science['matching_controls']==6,'Independent native science accepted complete fields')
    check(not science['assembly_performed'] and not science['moment_or_Ritz_claim'] and not resource['assembly_run'],'No assembled scalar in accepted reviews')
    check(ledger['reserved_cpu']==sum(v['cpu'] for v in ledger['reservations'].values())==75076,'Native retained CPU75076')
    check(ledger['reservations']['historical/failed_native17396']['included_calibration_cpu']==852,'Calibration already inside17396')
    check(17396+112+16000+40000+512+1024+32==75076,'Native no-double-count permanent accounting')
    check(ledger['coordinator_terminal_CPU'] is None and resource['CPU_seconds']['coordinator_terminal'] is None,'Native terminal coordinator CPU unavailable')
    check(resource['CPU_seconds']['measured_component_sum_excludes_coordinator_tail']==5489.559902,'Native measured components exclude terminal tail')
    check([j['name'] for j in ledger['jobs']]==['producer_full','checker_full'],'Exactly two sequential native jobs')
    streams=[]
    for job in ledger['jobs']:
        name=job['name'];res=read(s+name+'/resources.json');req=read(s+name+'.request.json')
        check(job['state']==res['status']=='PASS' and res['exit_code']==0,'Native normal PASS '+name)
        check(res['all_children_reaped'] and res['survivors']=={} and res['orphan_wait4']==[],'Native recorded cleanup '+name)
        check(res['initial_target_observation']['limits_verified'] and res['individual_memory_OK'] and res['final_time_OK'],'Native limits flags '+name)
        check(res['wait4_cpu_seconds']<res['child_cpu_cap']-12 and job['terminal_guard_cpu_seconds']<res['parent_cpu_cap']-.25,'Native terminal role margins '+name)
        check(0<=job['guard_tail_cpu_seconds']<.25,'Measured guard tail '+name)
        check(bind(s+name+'.request.json',res['request_sha256'])==job['request_sha256'],'Native request chain '+name)
        check(bind(s+name+'/resources.json',job['resource_receipt_sha256'])==fields['bindings'][name.split('_')[0]]['resource_receipt']['sha256'],'Native resource chain '+name)
        raw=path(s+name+'/run.log').read_bytes();check(raw.endswith(b'\n'),'Native complete newline '+name)
        rows=[decode(line) for line in raw.decode().splitlines()]
        check(len(rows)==442 and [x['kind'] for x in rows]==['start']+['checkpoint']*440+['complete'],'442 native records '+name)
        terminal=rows[-1];check(terminal['fields_unscaled']==fields['signed_unscaled_fields'],'Native terminal signed fields '+name)
        controls=terminal['norm_controls_unscaled']+[terminal['T_norm_unscaled']] if name=='producer_full' else terminal['controls_unscaled']
        check(controls==fields['signed_unscaled_controls'],'Native terminal controls '+name)
        expected=[]
        for q,total,width in [(4,39711,4096),(6,7028847,16384)]:
            expected.extend((q,i,min(total,i+width),width) for i in range(0,total,width))
        for row,(q,a,b,width) in zip(rows[1:-1],expected):
            check((row['q'],row['rank_start_inclusive'],row['rank_end_exclusive'],row['target_count'],row['chunk_size'])==(q,a,b,b-a,width),'Recorded complete schedule '+name+'/'+str(a))
        streams.append(rows)
    for i,(a,b) in enumerate(zip(streams[0][1:-1],streams[1][1:-1])):
        check(a['chunk_fields_unscaled']==b['chunk_fields_unscaled'] and a['cumulative_fields_unscaled']==b['cumulative_fields_unscaled'],'Recorded crossimplementation chunk equality '+str(i))
    # The failure packets and reviews are independent of the accepted native fields.
    totals=[(75396,75076,75252),(75572,75252,75428)]
    for campaign,prior_charge,total in totals:
        f=R+H+f'assembly{campaign}_failure_receipt/';v=read(R+H+f'assembly{campaign}_failure_resource_review/VERDICT.json');receipt=read(f+'FAILURE_RECEIPT.json');l=read(f+'state/LEDGER.json')
        check(receipt['state']==l['state']=='FAILED_NO_RETRY' and l['no_retry'],'Retained failed no-retry '+str(campaign))
        check(receipt['retained_CPU_charge']==l['reserved_cpu']==sum(x['cpu'] for x in l['reservations'].values())==total,'Failure cumulative accounting '+str(campaign))
        check(receipt['prior_CPU_charge']==prior_charge and receipt['new_CPU_charge']==176,'Failure incremental176 '+str(campaign))
        check(not receipt['distinct_stage_144_reserved'] and len(l['assembly_jobs'])==1,'No distinct stage charge '+str(campaign))
        check(not receipt['new_attempt_authorized'] and not v['launch_authorized'] and not v['retry_authorized'],'Failure review grants no new authority '+str(campaign))
        check(receipt['coordinator_terminal_CPU'] is None and receipt['guard_terminal_CPU'] is None,'Failed control terminal CPU unknown '+str(campaign))
        check(receipt['native_ledger_sha256']==science['ledger_sha256'],'Native success not overwritten by failed assembly '+str(campaign))
    first=read(R+H+'assembly75396_failure_resource_review/VERDICT.json');second=read(R+H+'assembly75572_failure_resource_review/VERDICT.json')
    check(first['status']=='ACCEPT_RECORDED_FAILED_STARTUP_NO_WORKER_FORK' and not first['worker_started'] and not first['scalar_outputs_present'],'First startup failure, no algebra fork')
    error=path(R+H+'assembly75396_failure_receipt/state/cached_scalar_assembly.guard.stderr.log').read_text()
    check('MemoryError' in error and 'read_bytes' in error,'Whole-file hash startup failure traceback')
    check(second['status']=='ACCEPT_RECORDED_SCIENTIFIC_ASSERTION_FAILURE_NO_RESOURCE_TRIP_OBSERVED' and second['worker_started'],'Second scientific assertion failure')
    check(second['failure_message']=='accepted H2 polynomial mismatch' and not second['complete_terminal_resource_PASS_established'] and not second['producer_output_present'] and not second['distinct_stage_started'],'No resource PASS or scalar after assertion failure')
    res=read(R+H+'assembly75572_failure_receipt/state/cached_scalar_assembly/resources.json')
    check(res['exit_code']==1 and res['failure'] is None and res['status']=='FAILED_NO_RETRY','Observer null reason does not mean successful worker')
    check(res['all_children_reaped'] and res['survivors']=={} and res['orphan_wait4']==[],'Failed worker recorded cleanup')
    diagnosis=read(R+H+'H2_linear_source_diagnosis/VERDICT.json')
    check(diagnosis['status']=='SOURCE_BUG_IDENTIFIED_WRONG_H2_LINEAR_RIGHT_VECTOR' and not diagnosis['native_physical_inconsistency_demonstrated'],'Algebra source diagnosis leaves native fields accepted')
    # Exact one-argument repair is source-only. No target imports/evaluation.
    old=path(R+H+'assembly75572_proposal/assembly/producer_cached_assembly.py').read_text();new=path(R+H+'assembly75748_proposal/assembly/producer_cached_assembly.py').read_text()
    before='m2_int = [bil(ctx,qp,G), bil(ctx,qp,A), bil(ctx,p,A2)/4]';after='m2_int = [bil(ctx,qp,G), bil(ctx,qp,A,p), bil(ctx,p,A2)/4]'
    check(old.count(before)==1 and new==old.replace(before,after),'Exact single H2 right-vector source replacement')
    for f in ['assembly/producer_worker.py','distinct/reviewer.py','distinct/reviewer_worker.py','control/assembly_guard.py']:
        check(path(R+H+'assembly75572_proposal/'+f).read_bytes()==path(R+H+'assembly75748_proposal/'+f).read_bytes(),'Unchanged successor file '+f)
    source=read(R+H+'assembly75748_onearg_science_review/VERDICT.json');config=read(R+H+'assembly75748_proposal/ASSEMBLY_CONFIG.json')
    check(source['status']=='PASS' and source['source_manifest_sha256']=='581f69a1f4bc3ad28f45a915fb2cee9fa7adcb7597e5d202e74c8818f8cf9902','Exact successor scientific source PASS')
    check(not source['launch_authorized'] and not source['numerical_execution'] and source['shared_comparison_payload_keys']==20,'Source proof supplies no invocation/result')
    check(config['prior_permanent_CPU_charge']==75428 and config['assembly_CPU_not_yet_authorized']==320 and config['prospective_cumulative_CPU']==75748,'Future fresh320 remains uncharged')
    check(config['old_pilot_CPU_separate']==240 and not config['preparation_is_launch_authorization'],'Pilot separate, preparation no launch authority')
    check(not path(R+H+'assembly75748_state').exists() and not path(R+H+'assembly75748_launch').exists(),'Selected successor invocation NOT STARTED')
    control=read(R+H+'assembly75748_controller_review/VERDICT.json')
    check(control['status']=='PASS' and control['role']=='resource' and control['source_manifest_sha256']==source['source_manifest_sha256'],'Both exact-source75748 gates PASS')
    check(not control['launch_authorized'] and not control['actual_launch_gate_supplied'] and control['blocking_repairs']==[],'Controller source PASS grants no invocation')
    check(control['prior_permanent_CPU']==75428 and control['fixed_new_CPU']==320 and control['prospective_cumulative_CPU']==75748,'Controller qualified prospective accounting')
    check(len(aliases)==len(SOURCE_ALIASES),'All declared historical aliases used')
    return {'status':'PASS_STAGE38_DOCUMENTARY_ONLY','checked_utc':datetime.now(timezone.utc).isoformat(),'evidence_root':str(root),'checks_passed':len(checks),'checks':checks,'checked_files':checked,'manifest_maps':maps,'historical_aliases':aliases,'manifest_namespace_aliases':NAMESPACE_ALIASES,'external_tools':external,'unanchored_files':[], 'scope':{'frozen_stage37_preserved':True,'native_complete_fields_accepted':True,'signed_fields':8,'controls':6,'records_per_stream':442,'matching_chunks':440,'q4_supports':39711,'q6_supports':7028847,'native_retained_CPU':75076,'first_assembly_retained_CPU':176,'second_assembly_retained_CPU':176,'current_retained_CPU_excluding_pilot':75428,'pilot_CPU_separate':240,'current_retained_CPU_including_pilot':75668,'future320_not_charged':True,'prospective75748_not_current_charge':True,'native_measured_components_excluding_coordinator_tail_CPU':'5489.559902','all_terminal_campaign_CPU_known':False,'assembly75748_science_source':'PASS_SOURCE_ONLY','assembly75748_controller_source':'PASS_SOURCE_ONLY','assembly75748_invocation':'NOT_STARTED','assembled_N64_H3_scalar_available':False,'new_Ritz_or_gap':False,'new_positive_gap_rows':0,'positive_interval_unchanged':[0,0.118],'physical_work_executed':False,'target_code_imported':False,'active_processes_inspected':False,'future_launch_authorized':False,'root_freeze_approval_granted_by_this_review':False}}

def main():
    p=argparse.ArgumentParser();p.add_argument('--repo',required=True);p.add_argument('--receipt');p.add_argument('--check-system-tools',action='store_true');args=p.parse_args()
    report=verify(args.repo,args.check_system_tools)
    if args.receipt:
        out=Path(args.receipt).resolve();need(not out.is_relative_to(Path(args.repo).resolve()),'Receipt must be outside evidence root');out.write_text(json.dumps(report,indent=2)+'\n')
    print(json.dumps({'status':report['status'],'files':len(report['checked_files']),'checks':report['checks_passed'],'maps':len(report['manifest_maps']),'aliases':len(report['historical_aliases']),'external_tools':len(report['external_tools'])},indent=2))
if __name__=='__main__':main()
